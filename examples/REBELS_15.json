{
    "_notes": [
      "REBELS-25 CII data"
    ],
  
    "dataset": "../../pyuvimage/testing_data/Ruby_CO7-6/Ruby_CO7-6_48kms.npz",
    "out": "ALMAQuest_out",
    "noise": "difference",
  
    "spectral": {
      "rest_frequency_ghz": 1900.5369,
      "redshift": 7.31,
      "frame": "TOPOCENT"
    },
    "velocity_window_kms": null,
  
    "fov": 4.0,
    "pixel_scale": "auto",
    "oversample": 2,
    "image_centre": [0, 0],
    "_image_centre_note": "ring centre in [dRA, dDec] arcsec from the phase centre; checked on the dirty image (CASA mom0 peak is at dRA +2.1, dDec -2.8)",
    "primary_beam": {"enabled": true, "pb_factor": 1.13},
  
    "model": {
      "backend": "thindisk",
      "rotation_curve": "arctan",
      "options": {"n_rings": 10, "n_scale_lengths": 5, "scale_height_arcsec": 0.1}
    },
    "surface_brightness": {"type": "freeform"},
  
    "priors": {
      "centre_ra":           {"type": "Uniform",    "lower": -0.5,  "upper": 0.5},
      "centre_dec":          {"type": "Uniform",    "lower": -0.5,  "upper": 0.5},
      "v_sys":               {"type": "Uniform",    "lower": -300,  "upper": 300},
      "intensity":           {"type": "LogUniform", "lower": 1.0,   "upper": 200.0},
      "scale_radius":        {"type": "Uniform",    "lower": 0.1,   "upper": 1.5},
      "inclination":         {"type": "Uniform",    "lower": 10,    "upper": 80},
      "phi":                 {"type": "Uniform",    "lower": -90,   "upper": 170},
      "turnover_radius":     {"type": "Uniform",    "lower": 0.05,  "upper": 1.0},
      "maximum_velocity":    {"type": "Uniform",    "lower": 50,    "upper": 600},
      "velocity_dispersion": {"type": "Uniform",    "lower": 10,    "upper": 250}
    },
  
    "search": {
      "method": "lbfgs",
      "start": "centre",
      "restarts": 4,
      "maxiter": 500,
      "number_of_cores": 1
    },
    "_search_note": "for posteriors replace search with {\"method\": \"nautilus\", \"n_live\": 200, \"number_of_cores\": 4}",
  
    "write_cubes": true,
    "write_plots": true,
    "n_plot_channels": 8
  }
  