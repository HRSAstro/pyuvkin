{
    "_notes": [
      "REBELS-25 CII data"
    ],
  
    "dataset": "/Users/hstacey/Work/REBELS_25/Rebels25.concat.CII.npz",
    "out": "/Users/hstacey/Work/REBELS_25/REBELS_25_thindisk",
    "noise": "difference",
  
    "spectral": {
      "rest_frequency_ghz": 1900.5369,
      "redshift": 7.30650,
      "frame": "TOPOCENT"
    },
    "velocity_window_kms": [-300,300],
  
    "fov": 3.5,
    "pixel_scale": "auto",
    "oversample": 2,
    "image_centre": [0, 0],
    "_image_centre_note": "ring centre in [dRA, dDec] arcsec from the phase centre; checked on the dirty image (CASA mom0 peak is at dRA +2.1, dDec -2.8)",
    "primary_beam": {"enabled": true, "pb_factor": 1.13},
  
    "model": {
      "backend": "thindisk",
      "rotation_curve": "arctan",
      "options": {"n_rings": 4, "rmax": 1.0, "scale_height_arcsec": 0.016}
    },
    "surface_brightness": {
      "type": "freeform"
    },
  
    "priors": {
      "centre_ra":           {"type": "Uniform",    "lower": -0.5,  "upper": 0.5},
      "centre_dec":          {"type": "Uniform",    "lower": -0.5,  "upper": 0.5},
      "v_sys":               {"type": "Constant",   "value": 0},
      "intensity":           {"type": "Constant",   "value": 1.0},
      "scale_radius":        {"type": "Uniform",    "lower": 0.1,   "upper": 1.5},
      "inclination":         {"type": "Uniform",    "lower": 10,    "upper": 80},
      "phi":                 {"type": "Uniform",    "lower": -180,   "upper": -90},
      "turnover_radius":     {"type": "Uniform",    "lower": 0.01,  "upper": 0.5},
      "maximum_velocity":    {"type": "Uniform",    "lower": 50,    "upper": 600},
      "velocity_dispersion": {"type": "Uniform",    "lower": 10,    "upper": 200}
    },
  
    "search": {
      "method": "lbfgs",
      "start": "centre",
      "restarts": 4,
      "maxiter": 500,
      "number_of_cores": 1
    },
    "_search_note": "for posteriors replace search with {\"method\": \"nautilus\", \"n_live\": 200, \"number_of_cores\": 4}",
  
    "write_cubes": true,
    "write_plots": true,
    "n_plot_channels": 8,
    "moment_mask_snr": 3.0
  }
  