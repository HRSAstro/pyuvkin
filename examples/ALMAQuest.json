{
  "_notes": [
    "ALMAquest data. JSON does not allow // comments — use _keys for notes."
  ],

  "dataset": "~/Work/ALMAQuest_test/ALMAQuest_120s_CO1-0.npz",
  "out": "~/Work/ALMAQuest_test/ALMAQuest_discfit",
  "noise": "difference",

  "spectral": {
    "rest_frequency_ghz": 115.2712018,
    "redshift": 0.05389666667,
    "frame": "TOPOCENT"
  },
  "velocity_window_kms": null,

  "fov": 25,
  "pixel_scale": "auto",
  "oversample": 2,
  "image_centre": [0, 0],
  "_image_centre_note": "set to the source offset [dRA, dDec] arcsec from the phase centre",
  "primary_beam": {"enabled": true, "pb_factor": 1.13},

  "model": {
    "backend": "thindisk",
    "rotation_curve": "arctan"
  },
  "surface_brightness": {"type": "analytic"},

  "priors": {
    "centre_ra":           {"type": "Uniform", "lower": -0.2,  "upper": 0.2},
    "centre_dec":          {"type": "Uniform", "lower": -0.2,  "upper": 0.2},
    "v_sys":               {"type": "Uniform", "lower": -20,  "upper": 20},
    "inclination":         {"type": "Uniform", "lower": 10,    "upper": 80},
    "phi":                 {"type": "Uniform", "lower": 180,   "upper": 270},
    "velocity_dispersion": {"type": "Uniform", "lower": 10,    "upper": 150},
    "maximum_velocity":    {"type": "Uniform", "lower": 50,    "upper": 400},
    "intensity":           {"type": "LogUniform", "lower": 0.1,   "upper": 200.0},
    "scale_radius":        {"type": "Uniform",    "lower": 0.1,   "upper": 5.0},
    "turnover_radius":     {"type": "Uniform",    "lower": 0.05,   "upper": 5.0}
  },
  "_priors_note": "parametric arctan disc; for free rings use backend bbarolo, rotation_curve rings, and vrot priors (see template_bbarolo.json)",

  "search": {
    "method": "lbfgs",
    "start": "centre",
    "restarts": 4,
    "eps": 1,
    "gtol": 1e-5
  },
  "_search_note": "for BBarolo free rings: start=bbarolo|fitmod3d seeds from FitMod3D; default eps/gtol then eps=1, gtol=2.5e-3*n_rings",

  "write_cubes": true,
  "write_plots": true,
  "n_plot_channels": 8
}
